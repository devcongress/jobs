# Secrets for testing should be added here.

# # == S3
# S3_ACCESS_KEY_ID=S3_ACCESS_KEY_ID
# S3_SECRET_ACCESS_KEY=S3_SECRET_ACCESS_KEY

# Dummy social sign-in credentials so the providers are registered in tests
# (OmniAuth runs in test mode; nothing calls Google or GitHub).
GOOGLE_CLIENT_ID=test-google-id
GOOGLE_CLIENT_SECRET=test-google-secret
GITHUB_CLIENT_ID=test-github-id
GITHUB_CLIENT_SECRET=test-github-secret
SLACK_CLIENT_ID=test-slack-id
SLACK_CLIENT_SECRET=test-slack-secret
SLACK_TEAM_ID=T0DEVCON
SLACK_WORKSPACE_URL=https://devcongress-community.slack.com

# Kept empty so tests never pick up real Slack credentials from .env (dotenv
# doesn't override variables that are already set). Tests that need Slack set
# a fake client explicitly.
SLACK_BOT_TOKEN=
SLACK_JOBS_CHANNEL_ID=
