# Secrets should NOT be added here.
# Set them in `.env.local`

# # == S3
# S3_REGION=S3_REGION
# S3_BUCKET=S3_BUCKET

# == Social sign-in (optional; each provider shows up only when both values are set)
# Callback URLs: <RAILS_DEFAULT_URL>/users/auth/google/callback and /users/auth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# == Slack (optional; each piece works once its values are set)
# Sign in with Slack. Callback: <RAILS_DEFAULT_URL>/users/auth/slack/callback
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_TEAM_ID=
# Bot token (scope chat:write) for #jobs posts and DMs; the bot must be in #jobs.
# SLACK_BOT_TOKEN=
# SLACK_JOBS_CHANNEL_ID=
# SLACK_INVITE_URL=
# SLACK_WORKSPACE_URL=https://devcongress-community.slack.com
