<% content_for :title, "Network" %>
<% tabs = [
     ["connections", "Connections", @counts["connections"]],
     ["followers", "Followers", @counts["followers"]],
     ["following", "Following", @counts["following"]],
     ["suggestions", "People you may know", nil]
   ] %>
<% empty = {
     "connections" => "No connections yet. When you and someone else follow each other, you're connected.",
     "followers" => "Nobody follows you yet. Share your profile page to get started.",
     "following" => "You're not following anyone yet. Find people in the developer directory.",
     "suggestions" => "No suggestions yet. Add skills to your profile and follow a few people, and we'll suggest more."
   } %>

<div class="mx-auto max-w-5xl space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="font-display text-3xl text-[var(--pu-text)]">Network</h1>
      <p class="text-sm text-[var(--pu-text-muted)]">Follow people to keep up with them. When you follow each other you're connected: connections can endorse your skills and see contact details you share with them.</p>
    </div>
    <a href="<%= main_app.developers_directory_path %>" class="pu-btn pu-btn-md pu-btn-outline shrink-0">
      <%= render Phlex::TablerIcons::Search.new(class: "mr-1 h-4 w-4") %> Find developers
    </a>
  </div>

  <nav class="flex gap-1 overflow-x-auto border-b border-[var(--pu-border)]" aria-label="Network">
    <% tabs.each do |key, label, count| %>
      <a href="<%= developers_profile_scoped_network_path(developers_profile_scoped: @profile, tab: key) %>"
         class="<%= class_names("-mb-px whitespace-nowrap border-b-2 px-4 py-2 text-sm font-medium",
              "border-primary-600 text-[var(--pu-text)]" => @tab == key,
              "border-transparent text-[var(--pu-text-muted)] hover:text-[var(--pu-text)]" => @tab != key) %>"
         <%= "aria-current=page" if @tab == key %>>
        <%= label %><% if count %> <span class="ml-1 rounded-full bg-[var(--pu-surface-alt)] px-2 py-0.5 text-xs"><%= count %></span><% end %>
      </a>
    <% end %>
  </nav>

  <% if @people.any? %>
    <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <% @people.each do |person| %>
        <li class="pu-card">
          <div class="pu-card-body flex items-start gap-4">
            <%= render InitialsAvatar.new(name: person.name, seed: person.handle, size: :md) %>
            <div class="min-w-0 flex-1">
              <a href="<%= main_app.developer_page_path(handle: person.handle) %>" class="block truncate font-semibold text-[var(--pu-text)] hover:text-primary-600 dark:hover:text-primary-400"><%= person.name %></a>
              <p class="truncate text-sm text-[var(--pu-text-muted)]">@<%= person.handle %><%= " · #{person.headline}" if person.headline.present? %></p>
              <% skills = person.profile_skills.map { |ps| ps.skill.name }.sort.first(4) %>
              <% if skills.any? %>
                <p class="mt-1 truncate text-xs text-[var(--pu-text-subtle)]"><%= skills.join(" · ") %></p>
              <% end %>
              <% if @follower_ids.include?(person.id) && !@following_ids.include?(person.id) %>
                <p class="mt-1 text-xs font-medium text-primary-600 dark:text-primary-400">Follows you</p>
              <% end %>
            </div>
            <div class="shrink-0">
              <%= render "shared/follow_button", profile: person, following: @following_ids.include?(person.id),
                    followed_by: @follower_ids.include?(person.id), variant: :portal, size: :sm %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="pu-card">
      <div class="pu-card-body text-center text-sm text-[var(--pu-text-muted)]"><%= empty.fetch(@tab) %></div>
    </div>
  <% end %>
</div>
