<% project = @project %>
<% owner = project.owner %>
<% content_for :title, "#{project.title} by #{owner.name}" %>
<% content_for :description, project.summary.presence || "#{project.title}, a project by #{owner.name} on DevCongress Connect" %>
<% content_for :noindex, true unless project.visible_to_everyone? && owner.visible_to_everyone? %>
<% if project.visible_to?(nil) %>
  <% og_card OgCard::Project.new(project) %>
  <% structured_data StructuredData::Project.new(project, contributors: @contributors.map(&:profile).select { |p| p.visible_to?(nil) }, view: self).to_h %>
<% end %>

<div class="dc-container max-w-5xl py-10">
  <%= link_to "← All projects", public_projects_path, class: "text-sm font-semibold text-[#555] hover:text-[#111]" %>

  <% if @own %>
    <div class="mt-6 flex flex-col gap-3 rounded-lg border-2 border-[#111] bg-[#f5e642] px-5 py-3 text-sm sm:flex-row sm:items-center sm:justify-between">
      <span>
        This is your project.
        <% if project.visible_to_hidden? %>It's <strong>hidden</strong>: only you can see it.<% elsif project.visible_to_members? %>It's visible to <strong>signed-in members</strong>.<% end %>
        <% if @pending_count.positive? %><%= pluralize(@pending_count, "contributor") %> still <%= @pending_count == 1 ? "has" : "have" %> to confirm.<% end %>
      </span>
      <%= link_to "Edit project", developer_portal_project_path(owner, project), class: "shrink-0 dc-btn dc-btn-white dc-btn-sm" %>
    </div>
  <% end %>

  <div class="mt-6 grid grid-cols-1 gap-10 lg:grid-cols-[2fr_1fr]">
    <article class="min-w-0">
      <h1 class="dc-heading text-5xl leading-tight"><%= project.title %></h1>
      <% if project.summary.present? %><p class="mt-3 text-lg text-[#555]"><%= project.summary %></p><% end %>

      <div class="mt-5 flex flex-wrap gap-2">
        <% project.skills.sort_by(&:name).each do |skill| %>
          <%= link_to skill.name, public_projects_path(skill: skill.slug), class: "rounded-full border border-[#e0ddd4] bg-[#f5f2e8] px-2.5 py-0.5 text-xs hover:bg-[#f5e642]" %>
        <% end %>
      </div>
      <% if project.period %><p class="mt-3 text-sm text-[#6b6b6b]"><%= project.period %></p><% end %>

      <% if project.repo_url.present? || project.demo_url.present? %>
        <div class="mt-6 flex flex-wrap gap-3">
          <% if project.demo_url.present? %>
            <%= link_to project.demo_url, target: "_blank", rel: "nofollow noopener", class: "dc-btn dc-btn-primary dc-btn-sm" do %>
              <%= render Phlex::TablerIcons::ExternalLink.new(class: "h-4 w-4") %> Live site
            <% end %>
          <% end %>
          <% if project.repo_url.present? %>
            <%= link_to project.repo_url, target: "_blank", rel: "nofollow noopener", class: "dc-btn dc-btn-white dc-btn-sm" do %>
              <%= render Phlex::TablerIcons::Code.new(class: "h-4 w-4") %> Source code
            <% end %>
          <% end %>
        </div>
      <% end %>

      <% if project.body.present? %>
        <div class="prose mt-8 max-w-none prose-a:text-[#e8117f]"><%= render_markdown(project.body) %></div>
      <% end %>
    </article>

    <aside class="space-y-6">
      <section class="dc-box p-5 shadow-[6px_6px_0_#e8117f]">
        <h2 class="dc-heading text-2xl">Built by</h2>
        <ul class="mt-4 space-y-4">
          <% [[owner, "Owner"], *@contributors.map { [_1.profile, _1.role.presence || "Contributor"] }].each do |person, role| %>
            <li>
              <%= link_to developer_page_path(person.handle), class: "group flex items-center gap-3" do %>
                <%= render InitialsAvatar.new(name: person.name, seed: person.handle) %>
                <span class="min-w-0">
                  <span class="block truncate font-semibold group-hover:text-[#e8117f]"><%= person.name %></span>
                  <span class="block truncate text-xs text-[#6b6b6b]"><%= role %></span>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    </aside>
  </div>
</div>
