<%# Stands in for a new profile the viewer can't see. Shows only when they joined. %>
<div class="flex items-start gap-3 rounded-lg border-2 border-dashed border-[#111] bg-white/60 p-5">
  <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-dashed border-[#6b6b6b] text-sm font-semibold text-[#6b6b6b]" aria-hidden="true">?</span>
  <span class="min-w-0 flex-1">
    <span class="block font-semibold">A new builder joined</span>
    <span class="block text-sm text-[#555]">
      <% if developer.visible_to_members? && current_user.nil? %>
        Members-only profile. <%= link_to "Sign in", rodauth(:user).login_path, class: "dc-link" %> to see it.
      <% else %>
        Their profile is private.
      <% end %>
    </span>
    <span class="mt-0.5 block text-xs text-[#6b6b6b]">Joined <%= time_ago_in_words(developer.created_at) %> ago</span>
  </span>
</div>
