<% skills = developer.profile_skills.map { |ps| ps.skill.name }.sort.first(3) %>
<%= link_to developer_page_path(developer.handle), class: "group flex items-start gap-3 dc-box p-5" do %>
  <%= render InitialsAvatar.new(name: developer.name, seed: developer.handle) %>
  <span class="min-w-0 flex-1">
    <span class="flex items-center gap-2">
      <span class="truncate font-semibold group-hover:text-[#e8117f]"><%= developer.name %></span>
      <% unless developer.not_looking? %><%= availability_pill(developer) %><% end %>
    </span>
    <span class="block truncate text-sm text-[#555]"><%= developer.headline.presence || "@#{developer.handle}" %></span>
    <% if developer.location.present? %><span class="mt-0.5 block truncate text-xs text-[#6b6b6b]"><%= developer.location %></span><% end %>
    <% if skills.any? %>
      <span class="mt-2 flex flex-wrap gap-1.5">
        <% skills.each do |skill| %><%= pill(skill) %><% end %>
      </span>
    <% end %>
  </span>
<% end %>
