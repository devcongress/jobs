<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), "DevCongress Connect"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="DevCongress Connect">
    <% if content_for?(:description) %><meta name="description" content="<%= content_for(:description) %>"><% end %>
    <% if content_for?(:noindex) %><meta name="robots" content="noindex"><% end %>
    <link rel="canonical" href="<%= canonical_url %>">
    <meta property="og:site_name" content="<%= SeoHelper::SITE_NAME %>">
    <meta property="og:title" content="<%= content_for(:title).presence || SeoHelper::SITE_NAME %>">
    <% if content_for?(:description) %><meta property="og:description" content="<%= content_for(:description) %>"><% end %>
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:type" content="<%= content_for(:og_type).presence || "website" %>">
    <meta property="og:image" content="<%= content_for(:og_image).presence || og_image_url(OgCard::Site.new) %>">
    <meta property="og:image:width" content="<%= OgCard::Base::WIDTH %>">
    <meta property="og:image:height" content="<%= OgCard::Base::HEIGHT %>">
    <meta property="og:image:alt" content="<%= content_for(:title).presence || SeoHelper::SITE_NAME %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@devcongress">
    <% if content_for?(:structured_data) %><script type="application/ld+json"><%= content_for(:structured_data) %></script><% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-[#f5f2e8] text-[#111] antialiased">
    <%= render "site/shared/header" %>
    <%= render "site/shared/flash" %>
    <main><%= yield %></main>
    <%= render "site/shared/footer" %>
  </body>
</html>
