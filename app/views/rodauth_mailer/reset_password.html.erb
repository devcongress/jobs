<% content_for :preheader, "Use this link within 24 hours to choose a new password." %>
<%= email_heading "Reset your password" %>
<%= render "greeting" %>
<%= email_paragraph do %>
  Someone asked to reset the password for <strong><%= @account.email %></strong> on <%= @product_name %>. If that was you, choose a new password:
<% end %>
<%= email_button "Choose a new password", @url %>
<%= email_muted "The link works once and expires in 24 hours." %>
<%= email_link_fallback @url %>
<% content_for :footer_note, "Didn't ask for this? Ignore this email; your password stays the same." %>
